# Copy this file to ".env" and fill in your own values.
# The real ".env" file is private and is never uploaded to GitHub.

# Your Gemini API key from Google AI Studio (free tier)
GEMINI_API_KEY=put_your_key_here

# The Gemini model name. Check Google AI Studio for a current free model.
GEMINI_MODEL=gemini-3.5-flash-lite

# true = use fake answers (no API call, no key needed). false = call Gemini.
USE_MOCK_LLM=true
